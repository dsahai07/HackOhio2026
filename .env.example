# Server only. Get a key from https://aistudio.google.com/apikey
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
# Used on the third attempt after temporary server errors. Empty disables model switching.
GEMINI_FALLBACK_MODEL=gemini-3.1-flash-lite
# Required in production. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Keep stable so saved browser sessions can resume after a restart.
SESSION_SECRET=
